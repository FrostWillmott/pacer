# LeetCode
LEETCODE_USERNAME=your_leetcode_username

# Study plan
NEW_PROBLEMS_PER_DAY_TOTAL=1
CONSOLIDATION_INTERVALS=3,14,45
MAINTENANCE_INTERVAL_DAYS=90
REVIEW_PER_DAY_CAP=4

# Timezone for Docker container (must match your macOS timezone)
TZ=Europe/Moscow

# Digest and networking
DIGEST_TIME=08:00
BACKEND_PORT=8000

# DB
POSTGRES_USER=leetcode_tracker
POSTGRES_PASSWORD=<generate with: python -c "import secrets; print(secrets.token_urlsafe(32))">
POSTGRES_DB=leetcode_tracker
POSTGRES_HOST=db
POSTGRES_PORT=5432
